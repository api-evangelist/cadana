    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Attach a custom sub",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cadanapay.com/v1/users/:userId/sub",
            "headers": [
              {
                "name": "X-MultiTenantKey",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the user"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Append your external token subject to cadana user"
        },
        {
          "info": {
            "name": "Add Admin",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cadanapay.com/v1/users/admins",
            "headers": [
              {
                "name": "X-MultiTenantKey",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add an admin to the business account"
        },
        {
          "info": {
            "name": "Remove Admin",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cadanapay.com/v1/users/admins/:userId",
            "headers": [
              {
                "name": "X-MultiTenantKey",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the user"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove an admin from the business account"
        },
        {
          "info": {
            "name": "Invite",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cadanapay.com/v1/users/invite",
            "headers": [
              {
                "name": "X-MultiTenantKey",
                "value": ""
              }
