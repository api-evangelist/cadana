        {
          "id": "434705e7-1529-476b-bb41-fb89774b0a50",
          "name": "Create a remittance",
          "request": {
            "name": "Create a remittance",
            "description": {
              "content": "**Beta** — contact Cadana to enable access for your business.\n\nInitiates a government payment. A remittance is always tied to one or\nmore `accepted` filings — whether Cadana prepared them\n(`source: cadana`) or you filed them externally and submitted the\ntotals (`source: external`). Funds are debited from your business\nbalance and routed to the authority through Cadana's local rails.\n\nBy default Cadana uses its internal mapping for the authority's bank\naccount. Provide a `paymentDetails` block — the same `paymentMethods`\nobject used by vendor payments and beneficiaries elsewhere in the API —\nto specify the routing yourself (for example, a Mexican CLABE under\n`bank.accountNumber`). Use the top-level `paymentReference` field to\nset the bank attribution reference (defaults to the linked filing's\n`filingReference`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "statutory",
                "remittances"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Required when using a Platform API token. The tenant key identifying which business to operate on.",
                "key": "X-MultiTenantKey",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessId\": \"<string>\",\n  \"countryCode\": \"<string>\",\n  \"filingIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"fundFromCurrency\": \"<string>\",\n  \"paymentDetails\": {\n    \"preferredMethod\": \"<string>\",\n    \"momo\": {\n      \"accountName\": \"<string>\",\n      \"provider\": \"<string>\",\n      \"providerCode\": \"<string>\",\n      \"phoneNumber\": {\n        \"countryCode\": \"<string>\",\n        \"number\": \"<string>\"\n      },\n      \"currency\": \"<string>\"\n    },\n    \"bank\": {\n      \"accountName\": \"<string>\",\n      \"accountNumber\": \"<string>\",\n      \"accountType\": \"<string>\",\n      \"ownerType\": \"<string>\",\n      \"bankCode\": \"<string>\",\n      \"bankName\": \"<string>\",\n      \"branchName\": \"<string>\",\n      \"sortCode\": \"<string>\",\n      \"iban\": \"<string>\",\n      \"provider\": \"<string>\",\n      \"currency\": \"<string>\",\n      \"beneficiaryId\": {\n        \"type\": \"<string>\",\n        \"value\": \"<string>\"\n      },\n      \"address\": {\n        \"line1\": \"<string>\",\n        \"city\": \"<string>\",\n        \"postalCode\": \"<string>\",\n        \"state\": \"<string>\",\n        \"countryCode\": \"<string>\",\n        \"line2\": \"<string>\"\n      },\n      \"phoneNumber\": {\n        \"countryCode\": \"<string>\",\n        \"number\": \"<string>\"\n      },\n      \"email\": \"<email>\"\n    }\n  },\n  \"paymentReference\": \"<string>\"\n}",
              "options": {
