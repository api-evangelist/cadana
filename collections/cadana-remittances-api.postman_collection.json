            "description": {
              "content": "**Beta** — contact Cadana to enable access for your business.\n\nReturns government payments across jurisdictions for a business. Each\nremittance is linked to one or more filings and tracks the actual money\nmovement to the government authority.\n\nThe response includes a `summary` object with counts by status.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "statutory",
                "remittances"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "businessId",
                  "value": "<string>",
                  "description": "Filter by business"
                },
                {
                  "disabled": false,
                  "key": "countryCode",
                  "value": "<string>",
                  "description": "Filter by jurisdiction (ISO 3166-1 alpha-2)"
                },
                {
                  "disabled": false,
                  "key": "status",
