  "item": [
    {
      "id": "416398d0-00a2-40cc-b8a3-18d34274f7d9",
      "name": "Requirements",
      "description": {
        "content": "Prerequisites that must be satisfied before filing",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c90760fc-cc30-4b32-81f3-7ac9433fc69c",
          "name": "List outstanding requirements",
          "request": {
            "name": "List outstanding requirements",
            "description": {
              "content": "Returns requirements — data inputs, documents, or registrations needed\nbefore filings can proceed.\n\nFilter by `businessId` for a business-wide view (all categories), or\nby `personId` to see what a specific worker is missing. At least one\nof `businessId` or `personId` must be provided, and `countryCode` is\nrequired whenever `personId` is used.\n\nRequirements are generated automatically based on the business's\njurisdictions and workforce composition. They update dynamically as\nworkers are added or laws change.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "statutory",
                "requirements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "businessId",
                  "value": "<string>",
                  "description": "Filter by business. Required unless `personId` is provided."
                },
                {
                  "disabled": false,
                  "key": "personId",
                  "value": "<string>",
                  "description": "Filter by person. Returns only `worker_data` requirements where\nthis person appears in `affected_persons`. Useful for building\nper-worker onboarding or compliance views. `countryCode` must be\nprovided alongside this parameter.\n"
                },
                {
                  "disabled": false,
                  "key": "countryCode",
                  "value": "<string>",
                  "description": "Filter by jurisdiction (ISO 3166-1 alpha-2). Required when `personId` is provided; the request fails with `400` if omitted."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Required when using a Platform API token. The tenant key identifying which business to operate on.",
                "key": "X-MultiTenantKey",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "af6f7d2f-7827-46a8-ab11-9ea3abba7b38",
              "name": "List of requirements",
              "originalRequest": {
                "url": {
