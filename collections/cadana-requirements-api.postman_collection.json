                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "disabled": false,
                    "description": "Required when using a Platform API token. The tenant key identifying which business to operate on.",
                    "key": "X-MultiTenantKey",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [\n    {\n      \"category\": \"business_registration\",\n      \"status\": \"satisfied\",\n      \"name\": \"SAT Employer RFC\",\n      \"description\": \"A valid RFC is required to file ISR returns with the Servicio de Administración Tributaria (SAT)\",\n      \"affectedField\": \"taxId\",\n      \"resourceType\": \"business\",\n      \"resourceId\": \"bus_abc123\",\n      \"resolutionGuide\": \"Submit via PUT /v1/statutory/businesses/{id}/fields/{countryCode}\"\n    },\n    {\n      \"category\": \"worker_data\",\n      \"status\": \"outstanding\",\n      \"name\": \"SAT Employer RFC\",\n      \"description\": \"A valid RFC is required to file ISR returns with the Servicio de Administración Tributaria (SAT)\",\n      \"affectedField\": \"taxId\",\n      \"resourceType\": \"business\",\n      \"resourceId\": \"bus_abc123\",\n      \"resolutionGuide\": \"Submit via PUT /v1/statutory/businesses/{id}/fields/{countryCode}\"\n    }\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
