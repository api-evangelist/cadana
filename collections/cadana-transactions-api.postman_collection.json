              "body": "{\n  \"data\": {\n    \"sourceCurrency\": \"USD\",\n    \"payouts\": [\n      {\n        \"paymentMethod\": \"bank\",\n        \"destinationCurrency\": \"AUD\",\n        \"destinationCountry\": \"AU\",\n        \"fee\": {\n          \"type\": \"fixed\",\n          \"value\": 1,\n          \"min\": 0,\n          \"max\": 0\n        },\n        \"feeCurrency\": \"USD\",\n        \"timeline\": {\n          \"minDays\": 1,\n          \"maxDays\": 2,\n          \"businessDaysOnly\": true\n        }\n      },\n      {\n        \"paymentMethod\": \"bank\",\n        \"destinationCurrency\": \"USD\",\n        \"destinationCountry\": \"EC\",\n        \"fee\": {\n          \"type\": \"fixed\",\n          \"value\": 6.5,\n          \"min\": 0,\n          \"max\": 0\n        },\n        \"feeCurrency\": \"USD\",\n        \"timeline\": {\n          \"minDays\": 0,\n          \"maxDays\": 1,\n          \"businessDaysOnly\": true\n        }\n      }\n    ]\n  }\n}",
