          "request": {
            "name": "Get user fees",
            "description": {
              "content": "Retrieve the payout catalog for a user — fees, delivery timelines, and transfer limits per corridor.\n\n`data.payouts` is the full, unfiltered catalog (the user's rate card) and is always returned.\n\nSupply `paymentMethod` together with `destinationCurrency` to also receive `data.estimate` — a per-transaction fee, delivery timeline, and transfer limits for the specified corridor. Add `destinationCountry` when several countries share a currency (e.g. USD sent to Ecuador vs. USD sent to El Salvador) so the estimate resolves to the right country. Add `sourceAmount` to resolve percentage-based fees into a concrete amount.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "users",
                ":userId",
                "fees"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sourceCurrency",
                  "value": "<string>",
                  "description": "ISO 4217 currency in which all fees are quoted. Defaults to `USD`."
                },
                {
                  "disabled": false,
                  "key": "paymentMethod",
                  "value": "<string>",
                  "description": "Payment method to produce an estimate for. Presence of this field triggers the `estimate` block in the response and requires `destinationCurrency`."
                },
                {
                  "disabled": false,
                  "key": "destinationCurrency",
                  "value": "<string>",
                  "description": "ISO 4217 payout currency — keys the specific corridor for the `estimate`. Required whenever `paymentMethod`, `destinationCountry`, or `sourceAmount` is supplied."
                },
                {
                  "disabled": false,
                  "key": "destinationCountry",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 destination country code. Use this when several countries share a currency (e.g. USD sent to Ecuador vs. USD sent to El Salvador) so the estimate resolves to the right country. Only meaningful when `destinationCurrency` is also supplied."
                },
                {
                  "disabled": false,
                  "key": "sourceAmount",
                  "value": "<string>",
                  "description": "Decimal payout amount used to resolve percentage-based fees into a concrete `estimate.fee.value`. Ignored for fixed-fee corridors. Requires `destinationCurrency`."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "userId",
                  "description": "(Required) The unique identifier for the user"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Required when using a Platform API token. The tenant key identifying which business to operate on.",
                "key": "X-MultiTenantKey",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
