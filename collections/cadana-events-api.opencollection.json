{
  "opencollection": "1.0.0",
  "info": {
    "name": "Embedded Consumer Wallets Balances Events API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List audit events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cadanapay.com/v1/statutory/events",
            "headers": [
              {
                "name": "X-MultiTenantKey",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "businessId",
                "value": "",
                "type": "query"
              },
              {
                "name": "resource_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "resource_id",
                "value": "",
                "type": "query",
                "description": "Filter events for a specific resource"
              },
              {
                "name": "event_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Return events after this timestamp"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination cursor from previous response"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "**Beta** — contact Cadana to enable access for your business.\n\n**Not yet implemented.**\n\nReturns the immutable audit log. Every state change on every resource\n(filing, remittance, requirement) is recorded as an event with the\nactor, timestamp, and before/after state.\n"
        }
      ]
    }
  ],
  "bundled": true
}